<?xml version="1.0" encoding="utf-8"?>
<!-- Vista propia de la pestaña "Pendientes": texto + punto amarillo a la derecha,
     centrado verticalmente con el texto. El id android:id/text1 hace que el
     TabLayout le ponga el texto de la pestaña. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/tab_pending"
        android:textAppearance="@style/TextAppearance.MatchesTab"
        android:textColor="@color/matches_tab_text" />

    <View
        android:id="@+id/tabPendingDot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_pending_dot"
        android:visibility="gone" />

</LinearLayout>
