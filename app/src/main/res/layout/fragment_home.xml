<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <include layout="@layout/component_app_bar" />

    <!-- Search bar "Buscar torneo...": mismo componente que Partidos, con
         ícono y hint propios de esta pantalla (ver HomeFragment). -->
    <include
        android:id="@+id/searchBar"
        layout="@layout/component_search_bar" />

    <!-- Listado de torneos: es el contenido principal de la pantalla. La
         ilustración de abajo es solo decoración de fondo, no debe competir
         visualmente con esto. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tournamentsList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Illustration band (trofeo): decorativa, anclada al fondo, detrás
         del listado. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.6"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_illustration_band_trofeo"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/noResultsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="220dp"
        android:layout_marginEnd="38dp"
        android:gravity="center"
        android:text="@string/search_no_results"
        android:textColor="@color/nav_tab_inactive_label"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
