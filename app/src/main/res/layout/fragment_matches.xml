<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.matches.MatchesFragment">

    <include layout="@layout/component_app_bar" />

    <!-- Search bar "Filtrar por torneo..." (nodo 30:1839). -->
    <include
        android:id="@+id/searchBar"
        layout="@layout/component_search_bar" />

    <!-- Tabs Voy / No voy / Pendientes (nodo 30:1858). -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/matchesTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="184dp"
        android:background="@color/surface_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabBackground="@drawable/bg_matches_tab"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/orange_primary"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@style/TextAppearance.MatchesTab"
        app:tabTextColor="@color/nav_tab_inactive_label">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_going" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_not_going" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_pending" />

    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_subtle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/matchesTabs" />

    <!-- Empty state (nodo 30:1850 "Voy" / 14:6371 "No voy" / 14:6291 "Pendientes"):
         el texto cambia acorde al tab seleccionado, ver MatchesFragment. -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="416dp"
        android:layout_marginEnd="38dp"
        android:gravity="center"
        android:text="@string/empty_state_matches_going"
        android:textColor="@color/nav_tab_inactive_label"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Listado de partidos del tab seleccionado, filtrado en el sitio por
         "Filtrar por torneo..." (ver MatchesFragment). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/matchesList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="233dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/noResultsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="260dp"
        android:layout_marginEnd="38dp"
        android:gravity="center"
        android:text="@string/search_no_results"
        android:textColor="@color/nav_tab_inactive_label"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Illustration band (cronómetro): decorativa, anclada al fondo,
         detrás del listado. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.6"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_illustration_band_cronometro"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Ícono de alerta flotante (nodo 115:6757): avisa que hay al menos un
         partido pendiente, se ve en cualquier pestaña, no solo en
         "Pendientes" (ver MatchesFragment). -->
    <ImageView
        android:id="@+id/pendingBadgeIcon"
        android:layout_width="16dp"
        android:layout_height="14dp"
        android:layout_marginTop="237dp"
        android:layout_marginEnd="61dp"
        android:src="@drawable/ic_warning_triangle"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
