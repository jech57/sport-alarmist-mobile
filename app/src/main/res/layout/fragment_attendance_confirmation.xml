<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.attendance.AttendanceConfirmationFragment">

    <include
        android:id="@+id/appBar"
        layout="@layout/component_app_bar" />

    <TextView
        android:id="@+id/tournamentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="21dp"
        android:layout_marginTop="122dp"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/teamsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="190dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/homeTeamIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/homeTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/label_vs"
            android:textColor="@color/nav_tab_inactive_label"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/awayTeamIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/awayTeamName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Fecha/hora + lugar: centrados entre los equipos y "Asistencia"
         (mismo margen arriba y abajo: INFO_GAP = 24dp). -->
    <TextView
        android:id="@+id/matchDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teamsRow"
        tools:text="12-11-2026 | 07:30 PM" />

    <!-- Lugar del partido: lo pone AttendanceConfirmationFragment ("Lugar: Cancha Campín"). -->
    <TextView
        android:id="@+id/matchLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/matchDateTime"
        tools:text="Lugar: Cancha Campín" />

    <!-- Illustration band (doodle): mismo lugar que en el mockup de Figma
         (frame "Confirmación de asistencia"), anclada al fondo.
         Va antes del scroll para quedar detrás de los recordatorios. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:alpha="0.6"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_illustration_band_doodle"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Asistencia + recordatorios: se puede hacer scroll para que los
         recordatorios nunca queden debajo de Cancelar / Guardar. La barra
         de scroll queda siempre visible (solo aparece si el contenido no cabe). -->
    <ScrollView
        android:id="@+id/attendanceScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        android:scrollbarSize="4dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/bg_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/bg_scrollbar_track"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/actionsRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/matchLocation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Asistencia: [Voy] [No voy] -->
            <LinearLayout
                android:id="@+id/attendanceRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/attendance_label"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/goingButton"
                    android:layout_width="88dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_attendance_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/tab_going"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/notGoingButton"
                    android:layout_width="88dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_attendance_idle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/tab_not_going"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Recordarme: solo visible cuando se elige "Voy" -->
            <LinearLayout
                android:id="@+id/remindersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="21dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/attendance_remind_me"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/reminderOneWeek"
                    style="@style/AttendanceReminderCheckBox"
                    android:text="@string/attendance_reminder_one_week" />

                <CheckBox
                    android:id="@+id/reminderThreeDays"
                    style="@style/AttendanceReminderCheckBox"
                    android:text="@string/attendance_reminder_three_days" />

                <CheckBox
                    android:id="@+id/reminderOneDay"
                    style="@style/AttendanceReminderCheckBox"
                    android:text="@string/attendance_reminder_one_day" />

                <CheckBox
                    android:id="@+id/reminderFiveHours"
                    style="@style/AttendanceReminderCheckBox"
                    android:text="@string/attendance_reminder_five_hours" />

                <CheckBox
                    android:id="@+id/reminderTwoHours"
                    style="@style/AttendanceReminderCheckBox"
                    android:text="@string/attendance_reminder_two_hours" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Cancelar / Guardar: van después de la ilustración para dibujarse encima -->
    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            layout="@layout/component_button" />

        <include
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/component_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>