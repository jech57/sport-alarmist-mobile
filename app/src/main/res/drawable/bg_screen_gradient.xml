<?xml version="1.0" encoding="utf-8"?>
<!-- Base screen gradient, ported from Figma node 30:1838 ("Inicio - voy"):
     linear-gradient(to bottom, #0a0e1a 0%, #0c0e16 34%, #0e0e10 72%).
     GradientDrawable's centerColor is fixed at 50%, not 34%, but the three
     tones are close enough that the difference isn't visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0A0E1A"
        android:centerColor="#0C0E16"
        android:endColor="#0E0E10" />
</shape>
