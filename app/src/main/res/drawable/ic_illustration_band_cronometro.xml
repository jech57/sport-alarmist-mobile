        android:pathData="M395.5,0.5H16.5C7.66344,0.5 0.5,7.66344 0.5,16.5V115.5C0.5,124.337 7.66344,131.5 16.5,131.5H395.5C404.337,131.5 411.5,124.337 411.5,115.5V16.5C411.5,7.66344 404.337,0.5 395.5,0.5Z"
        android:fillColor="#0E0E10"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.08"
        android:strokeWidth="1" />

    <!-- card background wash: same rounded-rect shape as the outline,
         filled with a radial gradient (its ellipse is approximated as a
         circle sized to the larger axis, see header). -->
    <path android:pathData="M396,1H16C7.71573,1 1,7.71573 1,16V116C1,124.284 7.71573,131 16,131H396C404.284,131 411,124.284 411,116V16C411,7.71573 404.284,1 396,1Z">
