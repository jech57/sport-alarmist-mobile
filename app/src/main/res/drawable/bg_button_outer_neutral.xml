<?xml version="1.0" encoding="utf-8"?>
<!-- Botón "Cancelar" (nodo 30:1811): frame exterior con gradiente y borde. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="#26262C"
        android:endColor="#17171B" />
    <stroke
        android:width="1dp"
        android:color="@color/button_border_neutral" />
</shape>
