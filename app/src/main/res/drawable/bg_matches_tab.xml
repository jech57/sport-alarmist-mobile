<?xml version="1.0" encoding="utf-8"?>
<!-- TabLayout per-tab background (nodo 30:1861 "Tab 1"): el tab seleccionado
     tiene un fill sólido propio (#412B1C) cubriendo toda la celda; los
     demás estados quedan transparentes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/matches_tab_selected_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
